[Unit]
Description=Rabbit isolated character OCR worker
After=network.target
[Service]
User=rabbitocr
Group=rabbitocr
WorkingDirectory=/opt/rabbit-platform/current/backend
EnvironmentFile=/etc/rabbit/ocr.env
Environment=OMP_THREAD_LIMIT=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStart=/opt/rabbit-platform/current/venv/bin/uvicorn app.ocr_worker:app --host 127.0.0.1 --port 8102 --workers 1 --no-access-log
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=768M
CPUQuota=80%
TasksMax=32
UMask=0077
[Install]
WantedBy=multi-user.target
